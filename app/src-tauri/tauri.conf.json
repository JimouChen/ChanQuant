{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChanQuant",
  "version": "0.3.0",
  "identifier": "com.neaya.chanquant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChanQuant · 三买分析工作台",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 740,
        "backgroundColor": "#f3f5f1",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../build/icon.png", "../build/icon.icns"]
  }
}
